PORT=5000
NODE_ENV=production

# Database Configuration (Railway / Standard MySQL)
# Option A: Connection URI (e.g. from Railway MySQL)
# DATABASE_URL=mysql://root:password@roundhouse.proxy.rlwy.net:12345/railway
# MYSQL_URL=mysql://root:password@roundhouse.proxy.rlwy.net:12345/railway

# Option B: Individual Parameters (Railway variables or custom)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ewaste_management

# Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=https://ecocycle-ewaste-management.vercel.app

# Meta WhatsApp Cloud API Configuration
# Get credentials from Meta for Developers: https://developers.facebook.com/apps/
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Indian SMS Gateway Configuration (Fast2SMS / MSG91 / Generic DLT Gateway)
SMS_PROVIDER=fast2sms
SMS_API_KEY=
SMS_SENDER_ID=ECOCYC
SMS_DLT_ENTITY_ID=
SMS_GATEWAY_URL=
